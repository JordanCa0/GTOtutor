# Copy to .env. Without a key the app still works; the AI coach panel just shows "unavailable".
ANTHROPIC_API_KEY=
# Optional overrides
CLAUDE_MODEL=claude-opus-5
EXPLANATION_MISS_LIMIT_PER_HOUR=50
# Cap on new coach answers per hour across all players (unset = no cap). Set this in production.
COACH_GLOBAL_LIMIT_PER_HOUR=
PORT=3001
# 0.0.0.0 inside a container; defaults to 127.0.0.1.
HOST=

# Supabase (see docs/accounts-and-data.md). Secret: never commit real values, never put them in the web app.
# Without DATABASE_URL, player data is kept in memory; without SUPABASE_URL, sign-in is disabled.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# JEV AI (TypeSafe Jev, https://api.typesafe.ai): drives opponent archetypes (docs/archetypes.md). Secret.
# Without a key, archetypes play the solver after the flop. JEV_MODEL defaults to jev-latest.
JEV_API_KEY=
JEV_MODEL=
# Premade archetype preflop charts (default preflop/charts/archetypes/<100bb charts version>.json, preflop-v9 under stacks-v1).
ARCHETYPE_CHARTS=
