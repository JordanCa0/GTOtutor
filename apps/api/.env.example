# Copy to .env. Without a key the app still works; the AI coach panel just shows "unavailable".
ANTHROPIC_API_KEY=
# Optional overrides
CLAUDE_MODEL=claude-opus-5
EXPLANATION_MISS_LIMIT_PER_HOUR=50
PORT=3001

# Supabase (see docs/accounts-and-data.md). Secret: never commit real values, never put them in the web app.
# Without DATABASE_URL, player data is kept in memory; without SUPABASE_URL, sign-in is disabled.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
